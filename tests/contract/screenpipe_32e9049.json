    "rejected_status": 403,
    "source": "crates/screenpipe-engine/src/server.rs is_api_auth_exempt_path and the api auth middleware",
    "exempt_paths": [
      "/health",
      "/ws/health",
      "/audio/device/status",
      "/vision/device/status",
      "/connections/oauth/callback",
      "/connections/browser/pair/start",
      "/connections/browser/pair/status",
      "/notify"
    ],
    "exempt_path_prefixes": [
      "/pipes/store"
    ],
    "exempt_path_patterns": [
      "/mcp-servers/*/oauth/callback"
    ]
  },
